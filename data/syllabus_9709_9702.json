  "mathematics_9709": {
    "code": "9709",
    "focus_paper": "Paper 4: Mechanics",
    "exam_format": {
      "duration_minutes": 75,
      "total_marks": 50,
      "questions": "6 to 8 compulsory structured questions"
    },
    "topics": [
      {
        "id": "9709-M1",
        "title": "Forces and equilibrium",
        "subtopics": [
          "Resolving coplanar forces into horizontal/vertical and parallel/perpendicular components",
          "Equilibrium of a particle under coplanar forces",
          "Friction: F <= mu*R, limiting equilibrium (F = mu*R), rough horizontal & inclined planes"
        ],
        "common_mistakes": [
          "Swapping sin(theta) and cos(theta) on inclined planes or when angle is measured from vertical",
          "Blindly setting F = mu*R when the system is static and not on the verge of sliding",
          "Forgetting normal reaction R changes when an applied force has a vertical/perpendicular component"
        ],
        "simulation_module": "vector-resolution-and-inclined-plane"
      },
      {
        "id": "9709-M2",
        "title": "Kinematics of motion in a straight line",
        "subtopics": [
          "Displacement, velocity, speed, and acceleration",
          "Displacement-time and velocity-time graphs",
          "Constant acceleration (SUVAT)",
          "Variable acceleration using calculus (differentiation & integration with boundary conditions)"
        ],
        "common_mistakes": [
          "Confusing total distance with net displacement when velocity changes sign",
          "Applying SUVAT equations when acceleration is variable",
          "Omitting integration constants (+C) or failing to split integrals at turning points (v = 0)"
        ],
        "simulation_module": "kinematics-graphs-and-calculus"
      },
      {
        "id": "9709-M3",
        "title": "Momentum",
        "subtopics": [
          "Linear momentum (p = mv)",
          "Conservation of linear momentum in direct impacts of two bodies in a straight line"
        ],
        "common_mistakes": [
          "Sign errors when particles rebound or move in opposite directions",
          "Confusing conservation of momentum with conservation of kinetic energy"
        ],
        "simulation_module": "1d-collisions-and-momentum"
      },
      {
        "id": "9709-M4",
        "title": "Newton's laws of motion",
        "subtopics": [
          "F = ma on horizontal and inclined planes",
          "Connected particles: strings, smooth pulleys, lifts, towing"
        ],
        "common_mistakes": [
          "Writing a single F = ma equation for particles moving on different planes",
          "Sign errors in tension T and acceleration a between connected bodies"
        ],
        "simulation_module": "connected-particles-and-pulleys"
      },
      {
        "id": "9709-M5",
        "title": "Energy, work and power",
        "subtopics": [
          "Work done by a constant force (W = Fd cos(theta))",
          "Kinetic energy (1/2 mv^2) and gravitational potential energy (mgh)",
          "Work-energy principle including work done against friction",
          "Power (P = Fv)"
        ],
        "common_mistakes": [
          "Omitting work done against resistance/friction in energy conservation",
          "Assuming driving force remains constant as velocity changes at constant power"
        ],
        "simulation_module": "work-energy-power-lab"
      }
    ]
  },
